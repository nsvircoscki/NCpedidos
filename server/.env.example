# Copie para .env (que não vai para o git) e ajuste.

# Banco local do docker-compose. Em produção: a URL do Neon, com ?sslmode=require.
DATABASE_URL=postgres://pedidos:pedidos@localhost:5433/pedidos

# Segredo que assina o token de login. Em produção, um texto longo e aleatório:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=troque-este-segredo

PORTA=3000
